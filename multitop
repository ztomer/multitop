#!/usr/bin/env bash
# Convenience launcher for the built binary.
set -euo pipefail
cd "$(dirname "$0")"

resolve_target_dir() {
    if [ -n "${CARGO_TARGET_DIR:-}" ]; then
        echo "$CARGO_TARGET_DIR"
        return
    fi
    local meta
    if command -v cargo >/dev/null 2>&1; then
        meta="$(cargo metadata --format-version 1 2>/dev/null | grep -o '"target_directory":"[^"]*"' | head -n1 | cut -d'"' -f4 || true)"
        if [ -n "$meta" ] && [ "$meta" != "null" ]; then
            echo "$meta"
            return
        fi
    fi
    # Only this checkout's target dir: a host-wide cache was a rung here until
    # 2026-09-21 and would have run whatever build last landed there.
    echo "$PWD/target"
}

TARGET_DIR="$(resolve_target_dir)"
BIN="$TARGET_DIR/release/multitop"
if [ ! -x "$BIN" ]; then
    BIN="$TARGET_DIR/debug/multitop"
fi
if [ ! -x "$BIN" ]; then
    printf 'x multitop not built yet - run ./build.sh or cargo build first.\n' >&2
    exit 1
fi
exec "$BIN" "$@"
