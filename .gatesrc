# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
GOH_LINE_EXCLUDE='crates/multitop/tests/event_loop_e2e\.rs|crates/multitop/src/diag\.rs|crates/agent/src/lib\.rs|crates/multitop/src/run/handle_key\.rs|crates/multitop/src/run/event_loop\.rs|crates/multitop/src/server\.rs|crates/multitop/src/state\.rs|crates/multitop/src/ui/keybar\.rs'       # length-only alias — cohesive modules + Hello(510) + handle_key palette(739) + event_loop focus(501) + server companion(504) + state layout(580) + keybar H/y(523)
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)
