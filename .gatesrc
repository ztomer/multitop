# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
GOH_LINE_EXCLUDE='crates/multitop/src/diag\.rs|crates/multitop/src/run/handle_key\.rs|crates/multitop/src/run/event_loop\.rs|crates/multitop/src/server\.rs|crates/multitop/src/state\.rs|crates/multitop/src/ui/keybar\.rs'       # length-only alias — cohesive modules + handle_key palette + event_loop focus(501) + server companion(504) + state layout(580) + keybar H/y(523)
GOH_LINE_BASELINE=tools/loc_baseline.txt   # ceilings for the LINE_EXCLUDE entries above
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# Every shipped configuration is linted, not just this machine's: the agent
# crate ships as a musl binary for Linux hosts, and an #[expect] fulfilled
# only on macOS is an error there (found 2026-09-14 by linting this target
# by hand). vault/multitop need dbus/tss system libraries to build on Linux
# and stay CI's.
GOH_RUST_LINT_CONFIGS='--target x86_64-unknown-linux-musl -p multitop-agent'

# Dependency currency as a RATCHET (gates_of_heck `goh deps`, in rust_gate.sh on
# the pre-push list). A direct dependency a major behind fails unless the file
# below holds it with its reason; an entry whose crate caught up fails until it
# is deleted, so the held set only shrinks. Minor drift stays reported, not
# failed: a lockfile refresh is routine and moves in its own commit.
GOH_DEPS_RATCHET=tools/deps_ratchet.txt

# Every scanner's floor (goh v0.27.0, 4.3): a full-scope scan that reads LESS than
# this has lost its subject and is red, not clean. The advisory line that
# printed these on 2026-10-14 read exactly the numbers below; each is at or a
# little under its own count. Lower one with the tree, in the same commit as
# whatever made the tree smaller -- never to absorb a scan that went blind.
GOH_EMOJI_MIN_FILES=434
GOH_CONFLICT_MARKERS_MIN_FILES=435
GOH_FILE_LENGTH_MIN_FILES=385
GOH_SECRETS_MIN_FILES=434
GOH_SHELL_LINT_MIN_FILES=10
GOH_EARLY_EXIT_PIPE_MIN_FILES=17
# Every early-exit-pipe finding FAILS here rather than being judged against a
# shrink-only seed (servers O45). It reads 0 findings; the key is what stops a
# future seed from becoming the ceiling.
GOH_NO_EARLY_EXIT_PIPE=1
GOH_DEAD_AFTER_EXEC_MIN_FILES=17
GOH_BARE_HOOK_INDEX_MIN_FILES=17
GOH_BARE_PYTHON_MIN_FILES=6
GOH_CHECKOUT_CREDENTIALS_MIN_FILES=2
GOH_MD_LINKS_MIN_LINKS=11
GOH_UNREAPED_SPAWN_MIN_FILES=249
GOH_SUBPROCESS_STDIN_MIN_CALLS=42

# goh's check_ci_local_parity.py matches CI's scripts by NAME in GOH_CI_STEPS,
# and the pre-push step runs the checkers through tools/checkers.sh's glob, which
# names none of them. Each is exempt for that reason alone; check_gate_parity.py
# is what holds the glob, the commit gate and CI's list to one set.
# Floor: CI runs 16 repo scripts today (13 checkers exempt below, plus
# tools/android_gate.sh, tools/coverage_check.sh and tools/ratchet_check.py); a
# scan reading fewer has lost its subject.
GOH_CI_PARITY_MIN_SCRIPTS=16
GOH_CI_PARITY_EXEMPT='tools/check_agent_version.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_codesign.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_doc_paths.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_gate_parity.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_key_hints.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_keychain_isolation.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_magic_numbers.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_msrv_claim.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_no_hard_coded_colour.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_one_escape_reader.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_row0_owner.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_test_only_code.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)
tools/check_unsafe_scope.py: run by tools/checkers.sh, which globs tools/check_*.py (check_gate_parity.py holds the glob to the CI list)'

# ── The gate of record ──────────────────────────────────────────────────────
# ONE list: tools/gate.sh --full (the pre-push hook) runs it through
# gates_of_heck/gates/local_ci.sh. It replaced scripts/local-ci.py (481 lines
# of orchestration: its own colours, its own fan-out, a second copy of the
# checker list) and tools/repo_gates.sh (a THIRD list) on 2026-09-14; the
# commit gate (tools/commit_gates.sh, run by tools/gate.sh --staged) and
# .github/workflows/ci.yml are the other two places gates are named, and
# tools/check_gate_parity.py holds all three to the glob.
# Steps are COLON-separated; none may contain a colon.
export GOH_DIR="${GOH_DIR:-$HOME/Projects/gates_of_heck}"
export MULTITOP_MOCK_KEYCHAIN=1   # the suites never reach the real keychain
export CI=1
export CARGO_INCREMENTAL=0
# MULTITOP_LIVE=1 is set on the pytest step and nowhere else: the live exec suite
# talks to real hosts for ~3.5 minutes, which is right before a push and a gate
# people learn to --no-verify past on a commit.
#
# installed_freshness runs on the PRE-PUSH list and deliberately not on every
# commit: its subject is the machine's installed binary, so it is red on any
# commit that changes the source until ./install.sh runs again. On the
# pre-commit hook it would be red on every commit, which is the same reason
# tools/lint_linux.sh is here and not there. It is also not on a
# `tools/check_*.py` name, so check_gate_parity.py does not demand it in the
# commit gate and in CI -- a gate that needs an install has nothing to check on a
# runner.
#
# bash tools/android_gate.sh is the Android companion's whole gate (android/,
# ROADMAP A2): ktlint, lint and kotlinc with warnings as errors, the JVM unit
# tests, the deprecation ratchet and the 64-bit-ABI check. CI's android job runs
# the same command; check_gate_parity.py fails either one dropping it.
#
# check_ci_local_parity.py (goh) fails when CI runs a tools/ or scripts/ script
# the steps below do not name (the exemptions above carry their reasons) -- a
# local gate weaker than CI is a gate that lets you push red.
GOH_CI_STEPS='"$GOH_DIR/gates/structural.sh" --full:tools/checkers.sh:ruff check --select PLW1510 .:"$GOH_DIR/gates/rust_gate.sh":python3 "$GOH_DIR/lib/advisory_db.py" run --fetch -- cargo audit --deny warnings --deny unmaintained --deny unsound --deny yanked:cargo test --workspace --all-features --doc:cargo build -p multitop && MULTITOP_LIVE=1 python3 -m pytest tests/ -q:python3 tools/ratchet_check.py --self-test && python3 tools/ratchet_check.py:tools/fuzz_check.sh:bash tools/android_gate.sh:bash "$GOH_DIR/gates/python.sh" "$GOH_DIR/checks/check_ci_local_parity.py":python3 tools/bench_check.py --self-test && python3 tools/bench_check.py:bash tools/coverage_check.sh:python3 tools/installed_freshness.py:tools/lint_linux.sh'

# The agent's MCP server (`multitop-agent mcp`), judged on the wire by goh's
# check_mcp_wire.py (queue MCP.MON). HOME is the gate's scratch directory, so
# it reads none of the owner's launch agents or docker contexts; it needs no
# host and no network.
GOH_MCP_SERVERS='HOME="$GOH_MCP_SCRATCH" cargo run --quiet --locked -p multitop-agent --bin multitop-agent -- mcp'
