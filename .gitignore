/target
.DS_Store

# Agent/assistant working directories — local tooling state, never shared.
.claude/
.opencode/

# Python bytecode from tooling scripts.
__pycache__/
*.pyc

# Local build settings. `rustc-wrapper = "sccache"` lives here for developers
# who have sccache installed; committing it made every other environment
# require it, and CI has no sccache, so `cargo test` died before compiling
# anything. See DEVELOPMENT.md.
.cargo/config.toml

# rustc internal-compiler-error dumps (crash reports, not source)
rustc-ice-*.txt

# the shared gate harness CI checks out beside the tree
/.gates_of_heck/

# The Android companion's build state (android/, ROADMAP A2). The SDK location
# comes from ANDROID_HOME (tools/android_gate.sh), never a committed path.
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
