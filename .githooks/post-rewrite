#!/bin/sh
# goh's hook shim (GOH.CLASS.ROLLOUT): the SAME bytes under every hook name, and no logic of its
# own. It finds the gates_of_heck checkout -- GOH_DIR (or GOH), then GOH_LIVE_ROOT, then the house
# default, then this repo when it IS gates_of_heck -- and runs that checkout's gates/hook.sh, read
# at run time. So a goh release changes what every repo's hooks do with no refresh: what a copy
# holds can go stale, and this holds nothing. A dead GOH_DIR (a pruned HEAD export) is skipped
# here and named by hook.sh. tests/test_hook_shim.py pins these bytes: changing them is the one
# change that needs every consumer refreshed, so it is a deliberate ABI bump, never an edit.
want="${GOH_DIR:-${GOH:-$HOME/Projects/gates_of_heck}}"
# path-ok: house default, after GOH_DIR, GOH and GOH_LIVE_ROOT
for GOH in "${GOH_DIR:-${GOH:-}}" "${GOH_LIVE_ROOT:-}" "$HOME/Projects/gates_of_heck" "${0%/*}/.."; do
    if [ -n "$GOH" ] && [ -f "$GOH/gates/hook.sh" ]; then
        exec bash "$GOH/gates/hook.sh" "$0" "$@"
    fi
done
echo "✗ ${0##*/}: no gates_of_heck at $want -- clone it there, or point GOH_DIR at your checkout" >&2
exit 1
