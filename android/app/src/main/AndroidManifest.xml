<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The pairing QR code. Optional: without a camera the string is pasted. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The paired server's read-only API, over pinned TLS on the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A3: a pushed alert is drawn as a notification (asked for at runtime, API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup is off and the extraction rules exclude everything: the
      pairing holds the server's bearer token, which must never leave the
      phone in a cloud backup or a device-to-device transfer.
      Cleartext is off explicitly as well as by default (API 28+): this client
      talks only pinned TLS (docs/roadmap.md, A2-TLS).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A3 push, UnifiedPush first (owner ruling OW.26): the connector binds
             this service with the distributor's endpoint and each message. -->
        <service
            android:name=".push.UpService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <!-- The FCM fallback; inert unless the build carried a Firebase config. -->
        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
